# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string → URI).
# Use the pooler URI for serverless deployments such as Vercel.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables "Ask Claude" suggestions for merchants the household has never
# categorized (server-side only). https://console.anthropic.com/
# ANTHROPIC_API_KEY=
